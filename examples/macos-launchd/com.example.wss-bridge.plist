<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.wss-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/danenberg/bin/wss-bridge-launcher</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/danenberg/Library/Logs/wss-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danenberg/Library/Logs/wss-bridge.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/danenberg</string>

    <!-- Keep the Mac from sleeping the user session while bridge is alive -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/danenberg/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
